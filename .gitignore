# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Source photography (173 MB of unoptimised originals).
#
# The app serves the WebP set in public/img, generated from these by
# scripts/optimize-images.mjs. Committing the originals would put 173 MB into git history
# permanently — git never forgets a blob — and slow every clone, for files no build step reads.
# Keep them in your own storage; re-run the script if you add or replace one.
/public/hotels

# Original hotel photos (5–20 MB each). The app uses the web-sized copies in public/images/hotels.
/public/hotels/

# Local tooling
/.claude/
/.impeccable/review/
/.impeccable/hook.cache.json
